# AMD/x86_64 서버에서 PyTorch IA-SSD 모델을 ONNX로 export하기 위한 환경이다.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:22.12-py3
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"

ENV TZ=Asia/Seoul \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /workspace/IA-SSD

# ONNX export와 pcdet extension 빌드에 필요한 기본 도구를 설치한다.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash-completion \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        htop \
        libboost-all-dev \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        nano \
        pkg-config \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-venv \
        wget && \
    rm -rf /var/lib/apt/lists/*

# IA-SSD/OpenPCDet 계열 코드와 ONNX export/검증에 필요한 Python 패키지를 설치한다.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        setuptools==59.8.0 \
        wheel \
        numpy==1.19.5 \
        llvmlite==0.36.0 \
        numba==0.53.1 \
        tensorboardX \
        easydict \
        pyyaml \
        scikit-image \
        tqdm \
        SharedArray \
        scipy \
        pybind11 \
        opencv-python-headless \
        onnx==1.13.1 \
        onnxsim==0.4.33 \
        onnxruntime-gpu==1.14.1

# spconv은 AMD 서버의 CUDA/PyTorch 조합에 맞는 wheel이 있을 때만 설치한다.
# 설치가 실패해도 export 스크립트에서 실제 필요 여부를 확인하며 진행할 수 있게 둔다.
RUN python3 -m pip install spconv-cu117 || \
    echo "spconv-cu117 설치를 건너뜁니다. 필요하면 AMD 서버 CUDA/PyTorch 버전에 맞는 spconv을 별도로 설치하세요."

RUN echo "export PYTHONPATH=/workspace/IA-SSD:\${PYTHONPATH}" >> /root/.bashrc

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["cd /workspace/IA-SSD && exec bash"]
