# 현재 target machine은 Jetson/L4T R35.4.1 계열이므로 Jetson용 PyTorch 이미지를 기본으로 사용한다.
# R35.4.1 전용 tag가 필요하면 빌드 시 BASE_IMAGE를 override한다.
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=noetic
ARG TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6"
ARG ONNXRUNTIME_GPU_WHEEL_URL=""

ENV TZ=Asia/Seoul \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ROS_DISTRO=${ROS_DISTRO} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH}

WORKDIR /workspace/IA-SSD

# Jetson target에서 ROS1 입력, TensorRT 실행, benchmark를 수행하기 위한 기본 도구를 설치한다.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-transport-https \
        bash-completion \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg2 \
        htop \
        libboost-all-dev \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        lsb-release \
        nano \
        pkg-config \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-venv \
        software-properties-common \
        wget && \
    rm -rf /var/lib/apt/lists/*

# ROS1 Noetic 저장소를 추가한다. Noetic은 Ubuntu 20.04와 Python 3 기반이라 이 프로젝트 목적에 맞다.
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add - && \
    echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros1-latest.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-pcl-ros \
        ros-${ROS_DISTRO}-ros-numpy \
        ros-${ROS_DISTRO}-tf \
        python3-catkin-tools \
        python3-rosdep \
        python3-rosinstall \
        python3-rosinstall-generator \
        python3-wstool && \
    rm -rf /var/lib/apt/lists/*

# Jetson/ARM64에서 wheel이 안정적인 패키지 위주로 target runtime 환경을 구성한다.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        setuptools==59.8.0 \
        wheel \
        importlib-metadata==4.13.0 \
        numpy==1.23.5 \
        llvmlite==0.41.1 \
        numba==0.58.1 \
        tensorboardX \
        easydict \
        pyyaml \
        scikit-image \
        tqdm \
        SharedArray \
        scipy \
        pybind11 \
        opencv-python-headless \
        onnx==1.13.1 \
        rospkg \
        catkin_pkg

# Jetson용 base image에 포함된 PyTorch를 검증한다.
# spconv은 Jetson용 pip wheel이 안정적으로 제공되지 않아 IA-SSD 실행 중 실제 필요성이 확인되면 별도 빌드한다.
RUN python3 -c "import torch; print(torch.__version__); print(torch.cuda.is_available())"

# Jetson용 ONNX Runtime GPU wheel은 JetPack/L4T 버전에 맞는 파일을 명시적으로 넣을 때만 설치한다.
RUN if [ -n "${ONNXRUNTIME_GPU_WHEEL_URL}" ]; then \
        python3 -m pip install "${ONNXRUNTIME_GPU_WHEEL_URL}"; \
    else \
        echo "ONNXRUNTIME_GPU_WHEEL_URL이 비어 있어 Jetson용 onnxruntime-gpu 설치를 건너뜁니다."; \
    fi

# ROS 환경이 새 쉘에서도 자동으로 잡히도록 설정한다.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc && \
    echo "export PYTHONPATH=/workspace/IA-SSD:\${PYTHONPATH}" >> /root/.bashrc

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["source /opt/ros/${ROS_DISTRO}/setup.bash && cd /workspace/IA-SSD && exec bash"]
